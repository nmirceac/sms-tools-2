{
    "name": "nmirceac/sms-tools-2",
    "type": "library",
    "description": "Laravel client for the WeAnswer SMS Toolkit (API v2): send SMS, track delivery and receive replies via signed webhooks.",
    "keywords": ["sms", "laravel", "sms-tools", "weanswer", "cm.com", "webhooks"],
    "homepage": "https://github.com/nmirceac/smsTools2",
    "license": "proprietary",
    "authors": [
        {
            "name": "Mircea Nicolae",
            "email": "mircea@nicolae.co.za",
            "homepage": "https://github.com/nmirceac",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.9|^3.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "SmsTools2\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SmsTools2\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SmsTools2\\SmsToolsServiceProvider"
            ],
            "aliases": {
                "Sms": "SmsTools2\\Facades\\Sms"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
